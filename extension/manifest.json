{
  "manifest_version": 3,
  "name": "AI Conversation Tree",
  "version": "0.1.0",
  "description": "Send ChatGPT, Claude, and Gemini conversations to your local AI Conversation Tree for graphing and cross-chat search.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "AI Conversation Tree", "default_popup": "src/popup.html" },
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["src/extract.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
